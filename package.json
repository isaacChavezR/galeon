{
  "name": "galeon-browser",
  "productName": "Galeón",
  "version": "0.10.1",
  "description": "Navegador privado que financia la limpieza de plásticos en ríos y océanos",
  "author": "Galeón",
  "license": "MIT",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "test": "node --test",
    "icons": "electron scripts/make-icons.js",
    "blocklist": "node scripts/fetch-easylist.js",
    "dist": "electron-builder --win nsis",
    "selftest": "electron . --selftest",
    "capture-test": "electron . --capture-test"
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^26.15.3",
    "electron-updater": "^6.8.9"
  },
  "build": {
    "appId": "app.galeon.browser",
    "productName": "Galeón",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "shield-core.js",
      "preload.js",
      "webview-preload.js",
      "renderer/**",
      "assets/**"
    ],
    "win": {
      "icon": "build/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": ["x64"]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "Galeón"
    }
  }
}
